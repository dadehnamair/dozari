# Copy to `.env.prod` next to docker-compose.prod.yml and fill in every line. Never commit the real file.

# The two public names (DNS A records to this server) that your reverse proxy forwards:
#   APP_DOMAIN -> 127.0.0.1:WEB_PORT,  API_DOMAIN -> 127.0.0.1:3000 (websockets on). See docs/deploy.md.
APP_DOMAIN=mrbots.ir
API_DOMAIN=api.mrbots.ir
# Host port (loopback only) of the web container; change it only if 8081 is taken.
WEB_PORT=8081

# Landing site (mrdozari.ir): the name it is served under and its loopback host port (forward LANDING_DOMAIN to 127.0.0.1:LANDING_PORT).
LANDING_DOMAIN=mrdozari.ir
LANDING_PORT=8083

# Mini-app (same game inside Bale / Telegram, own container): its public name and loopback host port. Needs BALE_BOT_TOKEN
# (and/or TELEGRAM_BOT_TOKEN) below. Old names BALE_APP_DOMAIN / BALE_APP_PORT still work.
MINIAPP_DOMAIN=mini-app.mrbots.ir
MINIAPP_PORT=8084

# Host port (loopback only) of phpMyAdmin; forward a domain of your choice to 127.0.0.1:PMA_PORT (docs/deploy.md §phpMyAdmin).
PMA_PORT=8082

# Catalogue seed after the migrations: empty = only when the database has no products yet (default, fresh installs fill themselves),
# 1 = full idempotent seed on every `up`, 0 = never.
SEED_ON_START=empty

# Database passwords: any long random strings (openssl rand -hex 24).
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Signs player sessions (32+ chars) and opens the admin panel (/admin on the API domain). The server refuses to
# start in production with short or default values.
JWT_SECRET=
ADMIN_TOKEN=

# Optional: Bale bot and SMS (leave empty to turn them off).
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
# Telegram bot of the mini-app login only (nothing else of the game talks to Telegram); empty = no Telegram login.
TELEGRAM_BOT_TOKEN=
IRNOTI_API_KEY=
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# Optional: error reports to a Sentry-compatible collector you host (GlitchTip), e.g. https://<key>@errors.example.ir/1
# Empty = no reports. Nothing is sent to Google.
SENTRY_DSN=
