# The web app (PWA) as plain HTTP inside the container. https and the domain names belong to the reverse proxy that
# already runs on the host (nginx, Caddy, Nginx Proxy Manager ...); it forwards:
#   APP_DOMAIN -> 127.0.0.1:WEB_PORT   (this container)
#   API_DOMAIN -> 127.0.0.1:3000       (the game server; websockets must be allowed)
{
	auto_https off
}

:80 {
	root * /srv/web

	# Downloads (the Android file lives at /download/apk/<version>/dozari.apk, committed under apps/mobile/public/download/).
	# No compression (an apk is already a zip), no app fallback: a wrong name is a real 404. `file_server` answers Range requests,
	# so an interrupted download resumes.
	handle /download/* {
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header Content-Disposition attachment
		header Cache-Control "public, max-age=300"
		file_server
	}

	handle {
		encode zstd gzip

		# Releases must be seen at once; hashed bundles never change.
		@sw path /sw.js
		header @sw Cache-Control "no-cache"
		@manifest path /manifest.webmanifest
		header @manifest Cache-Control "no-cache"
		@static path /_expo/static/*
		header @static Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
