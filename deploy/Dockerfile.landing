# Landing site `mrdozari.ir` (Fastify, server-rendered HTML). It has no database: it reads the game server's public content API.
FROM node:22-alpine
RUN corepack enable
WORKDIR /app
ENV NODE_ENV=production CI=1 npm_config_store_dir=/pnpm/store

# Manifests first so dependency layers cache.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/landing/package.json apps/landing/
RUN --mount=type=cache,id=dozari-pnpm,target=/pnpm/store pnpm install --frozen-lockfile --filter @dozari/landing... --prod

COPY tsconfig.base.json ./
COPY apps/landing apps/landing

WORKDIR /app/apps/landing
EXPOSE 3100
USER node
CMD ["node", "--import", "tsx", "src/index.ts"]
