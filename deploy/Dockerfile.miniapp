# Mini-app (Bale, Telegram): the game's web export, logged in through the messenger's signed initData, served by Caddy in its own container.
# Stage 1 builds the same Expo web bundle as deploy/Dockerfile.web (API address baked in) and reshapes index.html for the mini-app.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
ARG API_URL
ENV CI=1 EXPO_PUBLIC_API_URL=${API_URL}
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/mobile/package.json apps/mobile/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter @dozari/mobile...
COPY packages/shared packages/shared
COPY apps/mobile apps/mobile
COPY apps/miniapp apps/miniapp
WORKDIR /app/apps/mobile
RUN pnpm exec expo export -p web
RUN node ../miniapp/scripts/prepare-dist.mjs dist "${API_URL}"

FROM caddy:2-alpine
COPY apps/miniapp/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/mobile/dist /srv/web
