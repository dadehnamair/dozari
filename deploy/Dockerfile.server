# Game server (Fastify + Socket.io). The workspace packages are TypeScript sources, so it runs through tsx.
FROM node:22-alpine
RUN corepack enable && apk add --no-cache mariadb-client mariadb-connector-c
WORKDIR /app
ENV NODE_ENV=production CI=1

# Manifests first so dependency layers cache.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/server/package.json apps/server/
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
RUN pnpm install --frozen-lockfile --filter @dozari/server... --filter @dozari/db... --prod=false

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/db packages/db
COPY apps/server apps/server

WORKDIR /app/apps/server
EXPOSE 3000
USER node
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
