{
  "name": "@dozari/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "bot:run": "tsx src/bot/cli.ts",
    "admin:create": "tsx --env-file=../../.env src/admin/accounts/cli.ts"
  },
  "dependencies": {
    "@dozari/db": "workspace:*",
    "@dozari/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.1.0",
    "jose": "^6.2.12",
    "minio": "^8.0.7",
    "socket.io": "^4.8.4",
    "tsx": "^4.19.2",
    "uuidv7": "^1.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
