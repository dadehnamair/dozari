    "@expo/metro-runtime": "^57.0.16",
    "expo": "^57.0.25",
    "expo-font": "^57.0.4",
    "expo-secure-store": "^57.0.4",
    "expo-status-bar": "^57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.3",
    "socket.io-client": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "babel-preset-expo": "^57.0.13",
