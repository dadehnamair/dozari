# The mini-app (Bale, Telegram) as plain HTTP inside its own container; https and the domain belong to the host's reverse proxy
# (MINIAPP_DOMAIN -> 127.0.0.1:MINIAPP_PORT). Same game bundle as the web app, with the mini-app bridge in front (docs/logic/miniapp.md).
{
	auto_https off
}

:80 {
	root * /srv/web
	encode zstd gzip

	# The messenger's web view must always get the newest page; hashed bundles never change.
	@page path / /index.html /miniapp-bridge.js /sw.js
	header @page Cache-Control "no-cache"
	@static path /_expo/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Web clients open mini-apps in an iframe: send no X-Frame-Options and no frame-ancestors limit (Bale docs).
	header -X-Frame-Options

	try_files {path} /index.html
	file_server
}
