# The Bale mini-app as plain HTTP inside its own container; https and the domain belong to the host's reverse proxy
# (BALE_APP_DOMAIN -> 127.0.0.1:BALE_APP_PORT). Same game bundle as the web app, with the Bale bridge in front (docs/logic/bale-miniapp.md).
{
	auto_https off
}

:80 {
	root * /srv/web
	encode zstd gzip

	# Bale's web view must always get the newest page; hashed bundles never change.
	@page path / /index.html /bale-bridge.js /sw.js
	header @page Cache-Control "no-cache"
	@static path /_expo/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Only Bale may embed it (and the page opens normally in a plain browser).
	header Content-Security-Policy "frame-ancestors 'self' https://*.bale.ai https://bale.ai"

	try_files {path} /index.html
	file_server
}
