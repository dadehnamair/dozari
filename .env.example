# The one env file for everything: copy to `.env` (git-ignored) and fill it in.
# `docker compose` reads it automatically; scripts and the host dev server load it via `--env-file`.

# ===== Docker stack (docker-compose.yml) =====
# The two public names (DNS A records to this server) that your reverse proxy forwards:
#   APP_DOMAIN -> 127.0.0.1:WEB_PORT,  API_DOMAIN -> 127.0.0.1:3000 (websockets on). See docs/deploy.md.
APP_DOMAIN=mrbots.ir
API_DOMAIN=api.mrbots.ir
# Host port (loopback only) of the web container; change it only if 8081 is taken.
WEB_PORT=8081

# Landing site (mrdozari.ir): the name it is served under and its loopback host port (forward LANDING_DOMAIN to 127.0.0.1:LANDING_PORT).
LANDING_DOMAIN=mrdozari.ir
LANDING_PORT=8083

# Mini-app (same game inside Bale / Telegram, own container): its public name and loopback host port. Needs BALE_BOT_TOKEN
# (and/or TELEGRAM_BOT_TOKEN) below. Old names BALE_APP_DOMAIN / BALE_APP_PORT still work.
MINIAPP_DOMAIN=mini-app.mrbots.ir
MINIAPP_PORT=8084

# Host port (loopback only) of phpMyAdmin; forward a domain of your choice to 127.0.0.1:PMA_PORT (docs/deploy.md §phpMyAdmin).
PMA_PORT=8082

# Catalogue seed after the migrations: empty = only when the database has no products yet (default, fresh installs fill themselves),
# 1 = full idempotent seed on every `up`, 0 = never.
SEED_ON_START=empty

# Database passwords: any long random strings (openssl rand -hex 24).
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me

# JWT_SECRET and ADMIN_TOKEN are below (shared with the host dev server).

# Optional: Bale bot and SMS (leave empty to turn them off).
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
# Telegram bot: the notification bot next to Bale's; empty = no Telegram. TELEGRAM_API_BASE is the bot's IRNoti broker link (panel «event-broker»;
# the token is inside the link) used instead of https://api.telegram.org: requests go to <link>/<method>, e.g. https://events.irnoti.com/<name>/<key>; leave empty for direct access.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_BASE=
# Long-poll seconds for the Telegram bot (default 5): a relay answers 504 when the poll outlives its gateway timeout; lower it if you still see `getUpdates 504`.
TELEGRAM_POLL_SECONDS=5
IRNOTI_API_KEY=
IRNOTI_LINE_ID=
IRNOTI_PATTERN_CODE=gdhsgcnt
IRNOTI_MESSAGE=
# Android push via IRNoti: numeric id of the push app (IRNoti panel -> project -> Push); IRNOTI_API_KEY needs the broker.write scope.
IRNOTI_PUSH_APP_ID=
# Optional, default https://api.irnoti.com
IRNOTI_BASE_URL=
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# Optional: error reports to a Sentry-compatible collector you host (GlitchTip), e.g. https://<key>@errors.example.ir/1
# Empty = no reports. Nothing is sent to Google.
SENTRY_DSN=

# Host port of MySQL (bound to 127.0.0.1 only).
MYSQL_PORT=3306
# COMPOSE_PROFILES=setup   # run migrate + seed on every `up`

# ===== App server (inside docker these come from docker-compose.yml; on the host from here) =====
# Signs player sessions (32+ chars in production) and opens the admin panel. The server refuses to start in production with short/default values.
JWT_SECRET=change-me-to-a-long-random-string-32chars
# Host dev only (docker sets its own). Password = MYSQL_PASSWORD above.
DATABASE_URL=mysql://dozari:change-me@localhost:3306/dozari
# Optional: max MySQL connections per server process (default 20)
# DB_POOL_SIZE=20

# --- Image storage: pick ONE ---
# (a) Docker-free local dev: images are copied here and served by the API at /images/*
LOCAL_IMAGES_DIR=../../.local/images
LOCAL_IMAGES_PUBLIC_URL=http://localhost:3000/images

# (b) S3-compatible (MinIO via docker compose, or ArvanCloud in prod). When S3_ENDPOINT is set it wins.
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=dozari
# S3_SECRET_KEY=dozari-secret
# S3_BUCKET=dozari-images
# S3_PUBLIC_BASE_URL=http://localhost:9000/dozari-images

# Interim catalog review page at http://localhost:3000/admin (approve/reject prices).
# Leave unset to disable it entirely. Use a long random value anywhere but your own machine.
ADMIN_TOKEN=dev-admin

# Database backups to S3 (admin ← سیستم ← بک‌آپ دیتابیس). Needs `mysqldump` on PATH (apt install mysql-client / mariadb-client).
# Key that seals the S3 secret keys stored in the DB; falls back to ADMIN_TOKEN. Set it once and never change it.
# BACKUP_SECRET_KEY=

# CafeBazaar Pishkhan API token (read-only release status in admin ← آمار نصب و بازی ← نصب‌ها). Per app: Bazaar panel ← API پیشخان بازار.
# BAZAAR_PISHKHAN_TOKEN=
# BACKUP_SCHEDULER=off   # disable the scheduled runs on this instance
# MYSQLDUMP_BIN=mysqldump
# The newest N good backups per target can never be deleted from the panel (default 10; env only).
# BACKUP_PROTECT_LAST=10

# Browser origins allowed to call the API (only needed for Expo web dev, e.g. http://localhost:8081).
# `*` allows any origin. Leave unset for native-only use.
# CORS_ORIGIN=http://localhost:8081

# Signs guest session tokens (>= 16 chars). Required when NODE_ENV=production; dev falls back to a fixed secret.


# Bale messenger bot (Telegram-compatible API). Create the bot with @botfather on Bale, then:
# Telegram bot + mini-app (same game, same tables; docs/logic/miniapp.md, docs/logic/bale-bot.md). Create it with @BotFather on Telegram:
# SMS code for phone verification. irnoti (preferred when set):
# or Kavenegar verify/lookup (fallback; also unverified):
# BALE_API_BASE=https://tapi.bale.ai

# Admin AI studio (docs/logic/ai-studio.md): set a key for each provider you want in the admin panel.
# AI_OPENAI_API_KEY=
# AI_DEEPSEEK_API_KEY=
# AI_GAPGPT_API_KEY=
# AI_AVALAI_API_KEY=
# AI_PARSPACK_API_KEY=    # ParsPack AI Studio: docs.parspack.com/ai-studio
# AI_ANTHROPIC_API_KEY=   # Claude: console.anthropic.com -> API keys
# AI_GEMINI_API_KEY=      # Gemini: aistudio.google.com/apikey
# One more OpenAI-compatible gateway (any base URL ending before /chat/completions):
# AI_CUSTOM_BASE_URL=https://example.ir/v1
# AI_CUSTOM_API_KEY=
# AI_CUSTOM_NAME=درگاه من
# AI_CUSTOM_MODEL=gpt-4o-mini
# Override a preset's base URL: AI_<ID>_BASE_URL (e.g. AI_OPENAI_BASE_URL)

# Browser push (iPhone home-screen app, Android/desktop browsers). Generate once: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Android app push (FCM HTTP v1). Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Paste the JSON, or give the path of the file.
# FCM_SERVICE_ACCOUNT_JSON=/run/secrets/fcm-service-account.json

# Android app push through the irnoti push service (takes over from FCM_SERVICE_ACCOUNT_JSON when IRNOTI_PUSH_APP_ID and IRNOTI_API_KEY are set).
# irnoti panel -> Projects -> <project> -> Push -> new app (paste the Firebase service-account JSON there, not here).
# IRNOTI_PUSH_APP_ID=1              # numeric id of that app
# IRNOTI_API_KEY (above) needs the broker.write scope
# IRNOTI_BASE_URL=https://api.irnoti.com
