# Copy to `.env` (git-ignored). Scripts and the dev server load it via `--env-file`.
DATABASE_URL=mysql://dozari:dozari@localhost:3306/dozari

# --- Image storage: pick ONE ---
# (a) Docker-free local dev: images are copied here and served by the API at /images/*
LOCAL_IMAGES_DIR=../../.local/images
LOCAL_IMAGES_PUBLIC_URL=http://localhost:3000/images

# (b) S3-compatible (MinIO via docker compose, or ArvanCloud in prod). When S3_ENDPOINT is set it wins.
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=dozari
# S3_SECRET_KEY=dozari-secret
# S3_BUCKET=dozari-images
# S3_PUBLIC_BASE_URL=http://localhost:9000/dozari-images

# Interim catalog review page at http://localhost:3000/admin (approve/reject prices).
# Leave unset to disable it entirely. Use a long random value anywhere but your own machine.
ADMIN_TOKEN=dev-admin

# Browser origins allowed to call the API (only needed for Expo web dev, e.g. http://localhost:8081).
# `*` allows any origin. Leave unset for native-only use.
# CORS_ORIGIN=http://localhost:8081

# Signs guest session tokens (>= 16 chars). Required when NODE_ENV=production; dev falls back to a fixed secret.
# JWT_SECRET=change-me-to-a-long-random-string

# Bale messenger bot (Telegram-compatible API). Create the bot with @botfather on Bale, then:
# BALE_BOT_TOKEN=
# BALE_BOT_USERNAME=dozari_bot
# SMS code for phone verification. irnoti (preferred when set; unverified against the live service):
# IRNOTI_API_KEY=irnt_...
# IRNOTI_MESSAGE=کد ورود دوزاری: {code}
# or Kavenegar verify/lookup (fallback; also unverified):
# KAVENEGAR_API_KEY=
# KAVENEGAR_TEMPLATE=
# BALE_API_BASE=https://tapi.bale.ai

# Admin AI studio (docs/logic/ai-studio.md): set a key for each provider you want in the admin panel.
# AI_OPENAI_API_KEY=
# AI_DEEPSEEK_API_KEY=
# AI_GAPGPT_API_KEY=
# AI_AVALAI_API_KEY=
# One more OpenAI-compatible gateway (any base URL ending before /chat/completions):
# AI_CUSTOM_BASE_URL=https://example.ir/v1
# AI_CUSTOM_API_KEY=
# AI_CUSTOM_NAME=درگاه من
# AI_CUSTOM_MODEL=gpt-4o-mini
# Override a preset's base URL: AI_<ID>_BASE_URL (e.g. AI_OPENAI_BASE_URL)
