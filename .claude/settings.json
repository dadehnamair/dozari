{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(pnpm -r typecheck:*)",
      "Bash(pnpm -r lint:*)",
      "Bash(pnpm -r test:*)",
      "Bash(pnpm --filter * typecheck:*)",
      "Bash(pnpm --filter * lint:*)",
      "Bash(pnpm --filter * test:*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/.expo/**)",
      "Read(./pnpm-lock.yaml)"
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  }
}
